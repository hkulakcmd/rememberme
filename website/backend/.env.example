# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# PostgreSQL (dev stack from ../../db/docker-compose.yml)
DATABASE_URL=postgres://rememberme:change-me@localhost:5432/rememberme

# Tokens
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# URLs (same-origin through Next.js rewrites)
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# OAuth (Google Identity Services / Facebook JS SDK)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=mailto:admin@example.com

# Email (dev: console backend; prod: SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=RememberMe <no-reply@rememberme.local>
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# Security
AXES_ENABLED=True
