# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Development PostgreSQL (used by docker-compose.yml)
POSTGRES_DB=rememberme
POSTGRES_USER=rememberme
POSTGRES_PASSWORD=change-me

# Optional overrides
# DATABASE_URL=postgres://rememberme:change-me@localhost:5432/rememberme
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# URLs (same-origin through Next.js rewrites)
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# OAuth (Google Identity Services / Facebook JS SDK)
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Web Push (generate with: python -c "from py_vapid import Vapid; Vapid().generate_keys()")
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=mailto:admin@example.com
